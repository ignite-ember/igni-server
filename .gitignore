# Combined .gitignore

### Local scripts (throwaway debug, secrets, key pools) ###
/scripts/*
!/scripts/__init__.py
# Tracked, and run by CI: without this `git add -A` on a fresh export drops it.
!/scripts/check_migration_drift.py

### Node (the portal keeps its own; a root one is only ever a stray cache) ###
node_modules/

### Local igni workspace (user-specific symlink or directory) ###
/.igni
# The pre-rename name, kept so an unmigrated workspace stays ignored.
/.ember

### Evals fixtures (local-only, large) ###
/evals

