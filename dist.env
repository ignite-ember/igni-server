# ``prod`` deliberately: this template is what a deployment copies, and
# ``dev`` disarms the safety checks below — including the one that
# refuses a plain-HTTP PUBLIC_BASE_URL, over which this server's public
# keys could be replaced in transit. SECRET_ENCRYPTION_KEY is required
# even in dev.
#
# It does mean the *local* stack cannot use this value, because
# docker-compose.local.yml forces PORTAL_AUTH_BYPASS=1 and the checks
# refuse that outside dev. Rather than weaken the template, the local
# compose file now sets APP_ENV=dev itself — the development stack
# declares that it is the development stack.
APP_ENV=prod

LOG_LEVEL=INFO

# `text` for a person reading `docker logs`, `json` for a log shipper —
# one object per line, with the level and module as fields rather than
# inside a rendered string. Nothing is sent anywhere either way. See
# docs/observability.md.
LOG_FORMAT=text

# ── Email ───────────────────────────────────────────────────────────
#
# Off by default, and every flow has a defined answer for "and if it
# cannot be sent?": invite links come back to the admin who created them,
# and one-time codes reach nobody unless LOG_SIGN_IN_CODES (below) is on.
#
# SMTP_HOST used to read ``smtp.gmail.com`` here, which was right for one
# hosted deployment and wrong for every self-hosted one — a customer who
# configured nothing got a service convinced it could send mail, trying
# to reach Gmail from a network with no route to it.
#
# SMTP_TLS_MODE is ``starttls`` (587), ``tls`` (implicit, 465) or
# ``none`` (an internal relay on 25, the common air-gapped case — leave
# SMTP_USERNAME empty for it). These are different servers, not
# preferences.
#
# EMAIL_BACKEND=ses uses the SES API instead, which resolves the standard
# AWS credential chain and so stores no mail secret at all. See
# docs/self-hosting.md §6.
# A blank here is a validation error, not a default — this one is a
# boolean. Set it to true once SMTP_HOST or SES_REGION is filled in.
EMAIL_ENABLED=false
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SES_REGION=

# With no relay, write one-time codes (sign-in, sign-up, password reset)
# to the server log so an operator can hand them on. Off by default: the
# log becomes credential material — anyone who can read it, wherever it
# is shipped, can sign in as any user. This is the way in for first setup
# with no email: turn it on, sign in, configure a relay or SSO, turn it
# off. The server warns at startup and on every code while it is on.
LOG_SIGN_IN_CODES=false

# PostgreSQL. POSTGRES_DB defaults to ``igni``. Outside APP_ENV=dev the
# migration refuses to run when the database does not exist rather than
# creating one — a wrong name here would otherwise produce a deployment
# that boots cleanly, passes every health check and contains nothing.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# The connection pool. DB_POOL_SIZE + DB_MAX_OVERFLOW is the ceiling on
# concurrent queries **per process**, shared by everything in it — so the
# number your database has to allow is that ceiling times the number of
# processes: the API, the worker, the migration while it runs, and the
# backup if you enabled it.
#
# The compose stack's API and worker come to 20 + 40 = 60, inside a
# default Postgres max_connections of 100. A managed instance may allow
# far less: Cloud SQL's smallest tier permits 25 in total. The API logs
# both numbers at startup and warns when they cannot work, so read the
# first boot rather than guessing.
#
# DB_POOL_TIMEOUT is how long a request waits for a free connection
# before failing. Short on purpose — waiting 30 seconds and then failing
# means the client has already retried into the same full pool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=10

# Redis: Celery broker, concurrency leases, one-time codes.
REDIS_HOST=
REDIS_PORT=6379

# ── Audit trail retention ───────────────────────────────────────────
#
# `audit_events` records every privileged mutation and every
# authentication attempt: actor, action, target, outcome, source address.
# It is append-only (a database trigger rejects UPDATE) and readable by an
# admin at GET /v1/portal/audit-events.
#
# 0 keeps everything, which is the default. Set a window if you have a
# retention policy — GDPR Article 5(1)(e) asks for one and an auditor will
# ask for the number. Pruning is a no-op until you do, so nothing is
# discarded by surprise.
AUDIT_RETENTION_DAYS=0

# MCP
MCP_GATEWAY_URL=

# Upstream inference timeout, in seconds.
AI__UPSTREAM_TIMEOUT=300

# ── Secrets you MUST generate per deployment ─────────────────────────
#
# SECRET_ENCRYPTION_KEY is required in every environment, dev included:
# the server refuses to start without a valid one. It encrypts the
# secrets this deployment stores in its own database, and the first of
# those is the key it signs tokens with.
#
#   SECRET_ENCRYPTION_KEY: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#
# There is no token-signing secret to set. The server generates an RSA
# key pair on first start, keeps the private half in Postgres encrypted
# under this key, and publishes the public half at
# /.well-known/jwks.json. To rotate it: python tools/rotate_signing_key.py --stage
#
# Never copy this key between deployments, and back it up separately
# from the database — a backup holding both defeats the encryption.
SECRET_ENCRYPTION_KEY=

# Decrypt-only keys, comma-separated. Set only during a rotation:
#
#   1. mint a new key
#   2. move the current one here, put the new one above
#   3. restart — everything still decrypts, new writes use the new key
#   4. python tools/rotate_secret_key.py --apply
#   5. clear this and restart again
#
# Step 5 is the one people skip, and until it is done the superseded key
# still opens every stored secret — which is most of what rotating
# was for. The server warns on every boot while this is set.
SECRET_ENCRYPTION_KEYS_PREVIOUS=

# ── Public URLs ─────────────────────────────────────────────────────
#
# PUBLIC_BASE_URL is this server's own external address. It is the
# issuer (`iss`) of every token it signs, and the URL a service such as
# CodeIndex or Artifacts is deployed with, beside its own public URL: it
# finds the published keys and every endpoint from there, registers, and
# is approved on the portal's Services page (docs/service-identity.md).
# Nothing is set in this file for a service. Outside
# APP_ENV=dev it must be https:// or the server refuses to start, so
# blank is refused too. e.g. https://igni.example.com
PUBLIC_BASE_URL=

# The three below default to localhost, and they do not fail loudly:
# an invite email carrying a link to localhost:3000 sends fine and is
# useless to whoever receives it, and an OAuth callback pointing at a laptop is rejected by
# the provider rather than by us. The server warns about each of these
# at startup when APP_ENV is not dev.
PORTAL_BASE_URL=
OAUTH_REDIRECT_BASE_URL=
OAUTH_FRONTEND_BASE_URL=

# Break-glass key (bcrypt hash, never the password). Super admins are
# accounts: the first account this deployment creates is one, and they
# make others in the portal. This key is only for an install where
# nobody can sign in — it reaches deployment-wide settings and makes
# nobody a super admin. Empty: no break-glass.
SUPER_ADMIN_PASSWORD_HASH=

# Verification codes an anonymous caller can make this deployment send,
# across all addresses, per hour. Per-address limits are always on and
# not configurable: a 60-second cooldown and five per hour.
#
# This is the backstop against somebody spraying across many addresses
# from your relay identity, which is how a sending domain gets
# blacklisted. Generous by default; `0` disables it. An organisation
# onboarding three hundred people in an afternoon should raise it rather
# than discover sign-in switched off.
EMAIL_CODES_HOURLY_LIMIT=600

# ── SSO (OIDC) ──────────────────────────────────────────────────────
#
# Sign-in against the customer's own identity provider: Keycloak, Okta,
# Entra, Auth0, Authentik, Ping. One issuer URL configures the rest,
# because OIDC discovery publishes it.
#
# All three or none. With two of the three set, /v1/auth/oidc answers 404
# and the sign-in page shows no SSO button — the server warns about that
# at startup rather than leaving you to guess.
#
# The issuer must be https (localhost excepted). The signing keys for
# every login arrive over that connection, so plaintext means anybody who
# can see the traffic can sign in as anybody. Refused outside dev.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# What the button says. People recognise their provider's name.
OIDC_DISPLAY_NAME=SSO
# Which claim holds the address, if your provider does not use `email`.
OIDC_EMAIL_CLAIM=email
# Let an SSO login claim an existing local account with the same address.
# Off by default: with a provider that does not verify addresses, on is
# account takeover by email match.
OIDC_LINK_BY_EMAIL=false

# ── SCIM provisioning ───────────────────────────────────────────────
#
# Lets your identity provider create and **deprovision** accounts here,
# so removing somebody in Okta or Entra removes them from igni without
# anybody repeating the action in a second place. That repetition is
# the step that gets forgotten on the day it matters.
#
# The token is a shared secret you also paste into the provider. It is
# the provider's credential, not a person's: one tied to an employee
# stops working the day that employee leaves, which is the event it
# exists to survive.
#
# Empty **disables SCIM**: every /scim/v2 route answers 503. A
# provisioning API that accepted unauthenticated callers could create
# and remove accounts, so it fails closed.
#
# Point your provider at https://your-igni/scim/v2
SCIM_TOKEN=

# People it provisions join the organisation that owns their address's
# domain; an address on no organisation's domain is refused.

# ── Social sign-in ──────────────────────────────────────────────────
#
# The exception rather than the strategy. A company authenticates its
# people through SSO above, or through email and password; this list is
# for deployments that additionally want a provider button.
#
# A JSON array, because the setting is a list — `OAUTH_PROVIDERS=google`
# is a startup crash, not a one-element list.
#
# `[]` offers none. The sign-in page always has email and password, and
# SSO when the block above is filled in, so emptying this is a supported
# configuration and not a broken one. `google` is the only value
# accepted.
OAUTH_PROVIDERS=["google"]
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ── Monitoring ──────────────────────────────────────────────────────
#
# Bearer token a Prometheus scrape must present to read /metrics. Empty
# means the endpoint answers 404 rather than serving unauthenticated: the
# exposition lists every route template in the product and the version
# each replica runs.
#
# Alert rules to load alongside it: charts/igni/files/alerts.yaml.
METRICS_TOKEN=
